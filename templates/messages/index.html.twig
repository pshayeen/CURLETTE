{% extends 'base.html.twig' %}

{% block title %}Messages index{% endblock %}

{% block body %}
    <h1>Messages index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>SenderName</th>
                <th>SenderEmail</th>
                <th>SenderPhone</th>
                <th>MessageText</th>
                <th>IsRead</th>
                <th>CreatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for message in messages %}
            <tr>
                <td>{{ message.id }}</td>
                <td>{{ message.senderName }}</td>
                <td>{{ message.senderEmail }}</td>
                <td>{{ message.senderPhone }}</td>
                <td>{{ message.messageText }}</td>
                <td>{{ message.isRead ? 'Yes' : 'No' }}</td>
                <td>{{ message.createdAt ? message.createdAt|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_messages_show', {'id': message.id}) }}">show</a>
                    <a href="{{ path('app_messages_edit', {'id': message.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_messages_new') }}">Create new</a>
{% endblock %}
