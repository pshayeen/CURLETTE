{% extends 'base.html.twig' %}

{% block title %}Message from {{ message.senderName }} | Curlétte Admin{% endblock %}

{% block body %}

    <div class="page-header page-header-row">
        <div>
            <h1>Message from {{ message.senderName }}</h1>
            <p>Received on {{ message.createdAt ? message.createdAt|date('M j, Y g:i A') : '—' }}</p>
        </div>
        <span class="badge {{ message.isRead ? 'read' : 'unread' }}">{{ message.isRead ? 'Read' : 'Unread' }}</span>
    </div>

    <div class="table-wrap">
        <table>
            <tbody>
                <tr>
                    <th>Name</th>
                    <td>{{ message.senderName }}</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>{{ message.senderEmail }}</td>
                </tr>
                <tr>
                    <th>Phone</th>
                    <td>{{ message.senderPhone ?: '—' }}</td>
                </tr>
                <tr>
                    <th>Message</th>
                    <td>{{ message.messageText|nl2br }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="row-actions" style="margin-top: 20px;">
        <a href="{{ path('app_messages_index') }}" class="view-link">← Back to messages</a>
        {{ include('messages/_toggle_read_form.html.twig') }}
        {{ include('messages/_delete_form.html.twig') }}
    </div>

{% endblock %}