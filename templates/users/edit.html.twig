{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Edit User</h1>
        <p>{{ user.fullName|default(user.username) }}</p>
    </div>

    <div class="form-card">
        {{ include('users/_form.html.twig', {'button_label': 'Update'}) }}

        <p class="form-back"><a href="{{ path('app_users_index') }}">back to list</a></p>

        {{ include('users/_delete_form.html.twig') }}
    </div>
{% endblock %}