{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Edit User</h1>
        <p>{{ user.fullName|default(user.username) }}</p>
    </div>

    <div class="form-card">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            <div class="form-grid">
                <div class="full">
                    {{ form_label(form.fullName) }}
                    {{ form_widget(form.fullName, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.fullName) }}
                </div>
                <div>
                    {{ form_label(form.username) }}
                    {{ form_widget(form.username, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.username) }}
                </div>
                <div>
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div>
                    {{ form_label(form.phoneNumber) }}
                    {{ form_widget(form.phoneNumber, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.phoneNumber) }}
                </div>
                <div>
                    {{ form_label(form.roles) }}
                    {{ form_widget(form.roles, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.roles) }}
                </div>
                <div class="full">
                    {{ form_label(form.plainPassword) }}
                    {{ form_widget(form.plainPassword, {attr: {class: 'form-control'}}) }}
                    {{ form_help(form.plainPassword) }}
                    {{ form_errors(form.plainPassword) }}
                </div>
                {% if form.isActive is defined %}
                    <div class="full">
                        {{ form_widget(form.isActive) }}
                        {{ form_label(form.isActive) }}
                        {{ form_errors(form.isActive) }}
                    </div>
                {% endif %}
            </div>

            <div class="modal-actions" style="margin-top: 20px;">
                <a href="{{ path('app_users_index') }}" class="btn-outline">BACK TO LIST</a>
                <button type="submit" class="btn-main">UPDATE</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
