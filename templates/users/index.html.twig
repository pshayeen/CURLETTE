{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}

    <div class="page-header page-header-row">
        <div>
            <h1>Users</h1>
            <p>
                {% if search %}
                    {{ users|length }} result{{ users|length == 1 ? '' : 's' }} for “{{ search }}”.
                {% else %}
                    {{ users|length }} user{{ users|length == 1 ? '' : 's' }} registered.
                {% endif %}
            </p>
        </div>
        <button type="button" class="btn-main" data-bs-toggle="modal" data-bs-target="#addUserModal">
            + ADD USER
        </button>
    </div>

    {# added: search, handled by the repository's searchByKeyword method #}
    <div style="margin-bottom: 16px;">
        <form method="get" action="{{ path('app_users_index') }}" class="inline-form">
            <input type="text" name="q" value="{{ search }}" placeholder="Search by name, username or email..." style="width: 300px;">
            <button type="submit" class="btn-small">Search</button>
            {% if search %}
                <a href="{{ path('app_users_index') }}" class="view-link">Clear</a>
            {% endif %}
        </form>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Username</th>
                    <th>Phone</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>
                        <strong>{{ user.fullName|default(user.username) }}</strong>
                        <span class="muted">{{ user.email ?: '—' }}</span>
                    </td>
                    <td>{{ user.username }}</td>
                    <td>{{ user.phoneNumber ?: '—' }}</td>
                    <td>
                        <div class="row-actions">
                            <a href="{{ path('app_users_edit', {'id': user.id}) }}" class="view-link">edit</a>
                            {% if app.user and app.user.id == user.id %}
                                <span class="muted" style="margin: 0;">You</span>
                            {% else %}
                                <button type="button" class="btn-small-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                        data-name="{{ user.username }}"
                                        data-action="{{ path('app_users_delete', {'id': user.id}) }}"
                                        data-token="{{ csrf_token('delete' ~ user.id) }}">
                                    Remove
                                </button>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">{{ search ? 'No users match your search.' : 'no records found' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {# added: Add User modal, fields rendered one by one like the instructor's demo #}
    <div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserLabel" aria-hidden="true"
         data-open-on-load="{{ openAddModal|default(false) ? 'true' : 'false' }}">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 640px;">
            <div class="modal-content">
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    <div class="modal-heading">
                        <h2 id="addUserLabel">Add User</h2>
                        <p>Create an account that can log in.</p>
                    </div>

                    <div class="form-grid">
                        <div class="full">
                            {{ form_label(form.fullName) }}
                            {{ form_widget(form.fullName, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.fullName) }}
                        </div>
                        <div>
                            {{ form_label(form.username) }}
                            {{ form_widget(form.username, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.username) }}
                        </div>
                        <div>
                            {{ form_label(form.email) }}
                            {{ form_widget(form.email, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.email) }}
                        </div>
                        <div>
                            {{ form_label(form.phoneNumber) }}
                            {{ form_widget(form.phoneNumber, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.phoneNumber) }}
                        </div>
                        <div>
                            {{ form_label(form.plainPassword) }}
                            {{ form_widget(form.plainPassword, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.plainPassword) }}
                        </div>
                    </div>

                    <div class="modal-actions">
                        <button type="button" class="btn-outline" data-bs-dismiss="modal">CANCEL</button>
                        <button type="submit" class="btn-main">ADD USER</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    {# added: one Remove confirmation modal, filled in for each user #}
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content confirm-modal-content danger">
                <div class="confirm-modal-icon"><i class="bi bi-exclamation-triangle"></i></div>
                <h2>Remove this user?</h2>
                <p id="deleteLabel">This can’t be undone.</p>

                <form method="post" id="deleteForm">
                    <input type="hidden" name="_token" id="deleteToken">
                    <div class="confirm-modal-actions">
                        <button type="button" class="btn-outline" data-bs-dismiss="modal">GO BACK</button>
                        <button type="submit" class="btn-main is-danger">YES, REMOVE</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
<script>
    document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        document.getElementById('deleteLabel').textContent =
            'Remove “' + button.dataset.name + '”? They will no longer be able to log in.';
        document.getElementById('deleteForm').action = button.dataset.action;
        document.getElementById('deleteToken').value = button.dataset.token;
    });

    const addModal = document.getElementById('addUserModal');
    if (addModal.dataset.openOnLoad === 'true') {
        new bootstrap.Modal(addModal).show();
    }
</script>
{% endblock %}