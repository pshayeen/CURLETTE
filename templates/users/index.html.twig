{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}

    <div class="page-header page-header-row">
        <div>
            <h1>Users</h1>
            <p>{{ users|length }} account{{ users|length == 1 ? '' : 's' }}{{ term or role ? ' found' : ' in total' }}.</p>
        </div>
        <button type="button" class="btn-main" data-bs-toggle="modal" data-bs-target="#addUserModal">
            + ADD USER
        </button>
    </div>

    <div style="margin-bottom: 16px;">
        <form method="get" action="{{ path('app_users_index') }}" class="inline-form">
            <input type="text" name="q" value="{{ term }}" placeholder="Search by name, username or email..." style="width: 300px;">
            <select name="role" style="width: 140px;">
                <option value="">All roles</option>
                <option value="ROLE_ADMIN"{{ role == 'ROLE_ADMIN' ? ' selected' }}>Admin</option>
                <option value="ROLE_STAFF"{{ role == 'ROLE_STAFF' ? ' selected' }}>Staff</option>
                <option value="ROLE_USER"{{ role == 'ROLE_USER' ? ' selected' }}>Customer</option>
            </select>
            <button type="submit" class="btn-small">Filter</button>
            {% if term or role %}
                <a href="{{ path('app_users_index') }}" class="view-link">Clear</a>
            {% endif %}
        </form>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Date Created</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                {% set isSelf = app.user and app.user.id == user.id %}
                <tr>
                    <td>
                        <strong>{{ user.fullName|default(user.username) }}</strong>
                        <span class="muted">{{ user.email ?: '—' }}</span>
                    </td>
                    <td>{{ user.username }}</td>
                    <td>
                        {% if 'ROLE_ADMIN' in user.roles %}
                            <span class="badge admin">Admin</span>
                        {% elseif 'ROLE_STAFF' in user.roles %}
                            <span class="badge staff">Staff</span>
                        {% else %}
                            <span class="badge customer">Customer</span>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge {{ user.active ? 'active' : 'disabled' }}">{{ user.active ? 'Active' : 'Disabled' }}</span>
                    </td>
                    <td>{{ user.createdAt ? user.createdAt|date('M j, Y') : '—' }}</td>
                    <td>
                        <div class="row-actions">
                            <a href="{{ path('app_users_edit', {'id': user.id}) }}" class="view-link">edit</a>
                            {% if isSelf %}
                                <span class="muted" style="margin: 0;">You</span>
                            {% else %}
                                <form method="post" action="{{ path('app_users_toggle', {'id': user.id}) }}" style="display: inline;"
                                      onsubmit="return confirm('{{ user.active ? 'Disable' : 'Enable' }} this account?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
                                    <button type="submit" class="btn-small">{{ user.active ? 'Disable' : 'Enable' }}</button>
                                </form>
                                <button type="button" class="btn-small-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                        data-name="{{ user.username }}"
                                        data-action="{{ path('app_users_delete', {'id': user.id}) }}"
                                        data-token="{{ csrf_token('delete' ~ user.id) }}">
                                    Remove
                                </button>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">{{ term or role ? 'No users match your search.' : 'no records found' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserLabel" aria-hidden="true"
         data-open-on-load="{{ openAddModal|default(false) ? 'true' : 'false' }}">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 640px;">
            <div class="modal-content">
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    <div class="modal-heading">
                        <h2 id="addUserLabel">Add User</h2>
                        <p>Create an admin or staff account.</p>
                    </div>

                    <div class="form-grid">
                        <div class="full">
                            {{ form_label(form.fullName) }}
                            {{ form_widget(form.fullName, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.fullName) }}
                        </div>
                        <div>
                            {{ form_label(form.username) }}
                            {{ form_widget(form.username, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.username) }}
                        </div>
                        <div>
                            {{ form_label(form.email) }}
                            {{ form_widget(form.email, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.email) }}
                        </div>
                        <div>
                            {{ form_label(form.phoneNumber) }}
                            {{ form_widget(form.phoneNumber, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.phoneNumber) }}
                        </div>
                        <div>
                            {{ form_label(form.roles) }}
                            {{ form_widget(form.roles, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.roles) }}
                        </div>
                        <div class="full">
                            {{ form_label(form.plainPassword) }}
                            {{ form_widget(form.plainPassword, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.plainPassword) }}
                        </div>
                    </div>

                    <div class="modal-actions">
                        <button type="button" class="btn-outline" data-bs-dismiss="modal">CANCEL</button>
                        <button type="submit" class="btn-main">ADD USER</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content confirm-modal-content danger">
                <div class="confirm-modal-icon"><i class="bi bi-exclamation-triangle"></i></div>
                <h2>Remove this user?</h2>
                <p id="deleteLabel">This can’t be undone.</p>

                <form method="post" id="deleteForm">
                    <input type="hidden" name="_token" id="deleteToken">
                    <div class="confirm-modal-actions">
                        <button type="button" class="btn-outline" data-bs-dismiss="modal">GO BACK</button>
                        <button type="submit" class="btn-main is-danger">YES, REMOVE</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
<script>
    document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        document.getElementById('deleteLabel').textContent =
            'Remove “' + button.dataset.name + '”? Their records stay, but they can no longer log in.';
        document.getElementById('deleteForm').action = button.dataset.action;
        document.getElementById('deleteToken').value = button.dataset.token;
    });

    const addModal = document.getElementById('addUserModal');
    if (addModal.dataset.openOnLoad === 'true') {
        new bootstrap.Modal(addModal).show();
    }
</script>
{% endblock %}