<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Admin | Curlétte{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/C-icon.png') }}" type="image/png">

        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">

        <style>
            /* Curlétte colors and fonts */
            :root {
                --bg: #FFF7F3;
                --primary: #9B5F60;
                --secondary: #E8C8C5;
                --text: #3B2418;
                --muted: #765A50;
                --border: #E7DAD5;
                --font-heading: 'Cormorant Garamond', Garamond, serif;
                --font-body: 'Manrope', sans-serif;
            }

            * { margin: 0; padding: 0; box-sizing: border-box; }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: var(--font-body);
            }

            a { color: inherit; text-decoration: none; }

            /* LAYOUT */
            .layout { display: flex; min-height: 100vh; }

            /* SIDEBAR */
            .sidebar {
                position: sticky;
                top: 0;
                width: 250px;
                height: 100vh;
                flex-shrink: 0;
                display: flex;
                flex-direction: column;
                padding: 0 18px 26px;
                background: var(--primary);
            }

            .sidebar-header {
                display: flex;
                align-items: center;
                gap: 10px;
                height: 68px;
                margin: 0 -18px 18px;
                padding: 0 26px;
                background: var(--sidebar-bg-dark);
                border-bottom: 1px solid var(--sidebar-line);
            }

            .sidebar-header img { height: 40px; filter: brightness(0) invert(1); }

            .admin-tag {
                padding: 3px 8px;
                border-radius: 6px;
                background: #fff;
                color: var(--primary);
                font-size: 10px;
                font-weight: 800;
                letter-spacing: .6px;
            }

            .sidebar nav { flex: 1; }
            .sidebar ul { list-style: none; }
            .sidebar li { margin-bottom: 4px; }

            .sidebar nav a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 11px 12px;
                border-radius: 10px;
                color: var(--sidebar-text);
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                transition: background .2s ease, color .2s ease;
            }

            .sidebar nav a:hover { background: rgba(0, 0, 0, .18); color: #fff; }
            .sidebar nav a.active { background: #fff; color: var(--primary); font-weight: 800; }

            .logout-btn {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                padding: 9px 16px;
                border-radius: 10px;
                background: var(--secondary);
                color: var(--primary);
                font-size: 12px;
                font-weight: 700;
                cursor: pointer;
                transition: background .2s ease, color .2s ease;
            }

            .logout-btn:hover { background: var(--primary); color: #fff; }

            /* CONTENT */
            .main {
                flex: 1;
                min-width: 0;
                display: flex;
                flex-direction: column;
            }

            .content { flex: 1; padding: 36px 32px 50px; }

            /* TOPBAR */
            .topbar {
                position: sticky;
                top: 0;
                z-index: 10;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                height: 68px;
                padding: 0 32px;
                background: #fff;
                border-bottom: 1px solid var(--border);
            }

            .topbar-search {
                display: flex;
                align-items: center;
                gap: 8px;
                width: 280px;
                padding: 9px 14px;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: var(--bg);
                color: var(--muted);
            }

            .topbar-search input {
                flex: 1;
                border: 0;
                outline: none;
                background: transparent;
                color: var(--text);
                font-family: var(--font-body);
                font-size: 13px;
            }

            .topbar-actions { display: flex; align-items: center; gap: 18px; }

            .topbar-link {
                color: var(--muted);
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
            }

            .topbar-link:hover { color: var(--primary); }

            /* FOOTER */
            .footer {
                display: flex;
                justify-content: space-between;
                padding: 18px 32px;
                border-top: 1px solid var(--border);
                background: #fff;
                color: var(--muted);
                font-size: 12px;
            }

            /* PAGE HEADER */
            .page-header { margin-bottom: 28px; }

            .page-header h1 {
                font-family: var(--font-heading);
                font-size: 34px;
                font-weight: 600;
            }

            .page-header p {
                margin-top: 4px;
                color: var(--muted);
                font-size: 13px;
            }

            .page-header-row {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 20px;
            }

            /* STAT CARDS (dashboard) */
            .stats {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 18px;
                margin-bottom: 34px;
            }

            .stat-card {
                padding: 20px;
                border: 1px solid var(--border);
                border-radius: 18px;
                background: #fff;
                transition: transform .2s ease, box-shadow .2s ease;
            }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 26px rgba(59, 36, 24, .08);
            }

            .stat-icon {
                display: grid;
                place-items: center;
                width: 36px;
                height: 36px;
                margin-bottom: 12px;
                border-radius: 50%;
                background: var(--secondary);
                color: var(--primary);
                font-size: 16px;
            }

            .stat-card strong {
                display: flex;
                align-items: center;
                height: 34px;
                font-family: var(--font-heading);
                font-size: 30px;
                font-weight: 700;
                line-height: 1.1;
            }

            .stat-card.money strong { font-size: 24px; }
            .stat-card.alert strong { color: #9B3A3A; }

            .stat-card span {
                display: block;
                margin-top: 6px;
                color: var(--muted);
                font-size: 11px;
                font-weight: 700;
                letter-spacing: .3px;
                text-transform: uppercase;
            }

            /* PANELS (dashboard) */
            .panels {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 24px;
            }

            .panel {
                padding: 26px;
                border: 1px solid var(--border);
                border-radius: 20px;
                background: #fff;
            }

            .panel h2 {
                margin-bottom: 16px;
                font-family: var(--font-heading);
                font-size: 20px;
                font-weight: 700;
            }

            .row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 12px 0;
                border-bottom: 1px solid #F1E6E1;
                font-size: 13px;
            }

            .row:last-of-type { border-bottom: 0; }
            .row strong { display: block; }
            .row small { color: #8A7066; font-size: 11px; }

            .panel-footer {
                margin-top: 16px;
                padding-top: 16px;
                border-top: 1px solid #F1E6E1;
                font-size: 12px;
            }

            /* STATUS BADGES */
            .badge {
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: .3px;
                text-transform: uppercase;
            }

            .badge.placed     { background: var(--secondary); color: var(--primary); }
            .badge.processing { background: #FBE8CE; color: #B4720A; }
            .badge.fulfilled  { background: #DCEFE1; color: #2F7D4F; }
            .badge.cancelled  { background: #F6DADA; color: #9B3A3A; }
            .badge.upcoming   { background: var(--secondary); color: var(--primary); }
            .badge.completed  { background: #DCEFE1; color: #2F7D4F; }

            /* TABLES */
            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
                background: #fff;
                border: 1px solid var(--border);
            }

            th {
                padding: 14px 16px;
                border-bottom: 1px solid var(--border);
                background: var(--bg);
                color: var(--muted);
                font-size: 10px;
                font-weight: 800;
                letter-spacing: .5px;
                text-transform: uppercase;
                text-align: left;
            }

            td { padding: 12px 16px; border-bottom: 1px solid #F1E6E1; vertical-align: middle; }
            tbody tr:hover { background: var(--bg); }

            .table-wrap {
                overflow-x: auto;
                border: 1px solid var(--border);
                border-radius: 20px;
                background: #fff;
            }

            .table-wrap table { border: 0; }
            .table-wrap tr:last-child td { border-bottom: 0; }

            .muted {
                display: block;
                margin-top: 2px;
                color: #8A7066;
                font-size: 11px;
                font-weight: 500;
            }

            .stock-low { color: #9B3A3A; font-weight: 800; }

            .section-title {
                margin: 34px 0 14px;
                font-family: var(--font-heading);
                font-size: 22px;
                font-weight: 700;
            }

            /* FORMS */
            .content form div { margin-bottom: 14px; }

            .content label {
                display: block;
                margin-bottom: 6px;
                color: var(--muted);
                font-size: 12px;
                font-weight: 700;
            }

            .content input[type=text], .content input[type=number], .content input[type=email],
            .content input[type=date], .content input[type=time], .content select, .content textarea {
                width: 100%;
                max-width: 480px;
                padding: 10px 12px;
                border: 1px solid #DED0CA;
                border-radius: 10px;
                background: #fff;
                font-family: var(--font-body);
                font-size: 13px;
            }

            .content .form-control {
                width: 100%;
                max-width: 100%;
                padding: 10px 12px;
                border: 1px solid #DED0CA;
                border-radius: 10px;
                background: #fff;
                font-family: var(--font-body);
                font-size: 13px;
            }

            .content form ul { margin: 0 0 6px; padding: 0; list-style: none; color: #9B3A3A; font-size: 12px; }

            .form-card {
                max-width: 560px;
                padding: 28px;
                border: 1px solid var(--border);
                border-radius: 20px;
                background: #fff;
            }

            .form-back { margin-top: 18px; font-size: 12px; }

            .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
            .form-grid .full { grid-column: 1 / -1; }

            /* BUTTONS AND LINKS */
            .content button {
                padding: 9px 16px;
                border: 0;
                border-radius: 10px;
                background: var(--primary);
                color: #fff;
                font-family: var(--font-body);
                font-size: 12px;
                font-weight: 700;
                cursor: pointer;
            }

            .content a { color: var(--primary); font-weight: 700; }

            .content .view-link { color: var(--primary); font-size: 12px; font-weight: 700; }
            .content .view-link:hover { text-decoration: underline; }

            .content .btn-main,
            .content .btn-outline {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 38px;
                padding: 0 24px;
                border-radius: 50px;
                font-size: 12px;
                font-weight: 700;
                transition: .25s ease;
            }

            .content .btn-main { border: 0; background: var(--primary); color: var(--bg); }
            .content .btn-main:hover { opacity: .88; }
            .content .btn-outline { border: 2px solid var(--primary); background: transparent; color: var(--primary); }
            .content .btn-outline:hover { background: var(--primary); color: #fff; }
            .content .btn-main.is-danger { background: #9B3A3A; }
            .content .btn-main.is-danger:hover { background: #7d2e2e; opacity: 1; }

            .content .btn-small,
            .content .btn-small-danger {
                padding: 6px 12px;
                border-radius: 8px;
                font-size: 11px;
                font-weight: 700;
                white-space: nowrap;
            }

            .content .btn-small { border: 1px solid #DED0CA; background: #fff; color: var(--text); }
            .content .btn-small:hover { border-color: var(--primary); color: var(--primary); }
            .content .btn-small-danger { border: 0; background: #F6DADA; color: #9B3A3A; }
            .content .btn-small-danger:hover { background: #9B3A3A; color: #fff; }

            /* TABLE ROW HELPERS (Products page) */
            .row-actions { display: flex; align-items: center; gap: 12px; }
            .content .row-actions .view-link { margin-right: 0; }

            .inline-form { display: flex; align-items: center; gap: 6px; margin: 0; white-space: nowrap; }
            .inline-form span { color: #8A7066; font-size: 11px; font-weight: 700; }

            .content .inline-form input[type=number] {
                width: 80px;
                max-width: none;
                padding: 6px 8px;
                border-radius: 8px;
                background: var(--bg);
                font-size: 12px;
            }

            .content .inline-form.stock input[type=number] { width: 64px; }

            /* FLASH MESSAGES */
            .flash {
                margin-bottom: 20px;
                padding: 12px 16px;
                border-radius: 12px;
                font-size: 13px;
                font-weight: 600;
            }

            .flash-success { background: #DCEFE1; color: #2F7D4F; }
            .flash-danger  { background: #F6DADA; color: #9B3A3A; }

            /* MODALS (Bootstrap's JavaScript runs them, this styling is ours) */
            .fade { transition: opacity .15s linear; }
            .fade:not(.show) { opacity: 0; }

            .modal {
                position: fixed;
                top: 0;
                left: 0;
                z-index: 1055;
                display: none;
                width: 100%;
                height: 100%;
                overflow-x: hidden;
                overflow-y: auto;
                outline: 0;
            }

            .modal-dialog {
                position: relative;
                width: calc(100% - 32px);
                max-width: 480px;
                margin: 32px auto;
                pointer-events: none;
            }

            .modal.fade .modal-dialog { transform: translateY(-30px); transition: transform .25s ease-out; }
            .modal.show .modal-dialog { transform: none; }
            .modal-dialog-centered { display: flex; align-items: center; min-height: calc(100% - 64px); }

            .modal-content {
                position: relative;
                display: flex;
                flex-direction: column;
                width: 100%;
                padding: 32px 34px;
                border: 0;
                border-radius: 24px;
                background: #fff;
                box-shadow: 0 24px 60px rgba(59, 36, 24, .25);
                pointer-events: auto;
            }

            .modal-backdrop {
                position: fixed;
                top: 0;
                left: 0;
                z-index: 1050;
                width: 100vw;
                height: 100vh;
                background: #3B2418;
            }

            .modal-backdrop.fade { opacity: 0; }
            .modal-backdrop.show { opacity: .45; }

            .modal-heading h2 { margin-bottom: 6px; font-family: var(--font-heading); font-size: 28px; font-weight: 600; }
            .modal-heading p { margin-bottom: 22px; color: var(--muted); font-size: 13px; }
            .modal-actions { display: flex; gap: 12px; margin-top: 8px; }

            .content .modal-heading, .content .modal-actions { margin-bottom: 0; }
            .content .modal-actions .btn-outline, .content .modal-actions .btn-main { flex: 1; }

            .content .modal input[type=text], .content .modal input[type=number], .content .modal input[type=email],
            .content .modal input[type=date], .content .modal input[type=time], .content .modal select, .content .modal textarea {
                max-width: 100%;
            }

            .confirm-modal-content { padding: 40px 36px; text-align: center; }

            .confirm-modal-icon {
                display: grid;
                place-items: center;
                width: 56px;
                height: 56px;
                margin: 0 auto 18px;
                border-radius: 50%;
                background: var(--secondary);
                color: var(--primary);
                font-size: 24px;
            }

            .confirm-modal-content.danger .confirm-modal-icon { background: #F6DADA; color: #9B3A3A; }
            .confirm-modal-content h2 { margin-bottom: 8px; font-family: var(--font-heading); font-size: 26px; font-weight: 600; }
            .confirm-modal-content p { margin-bottom: 26px; color: var(--muted); font-size: 13px; line-height: 1.6; }
            .confirm-modal-actions { display: flex; gap: 12px; }
            .content .confirm-modal-actions { margin-bottom: 0; }
            .content .confirm-modal-actions .btn-outline, .content .confirm-modal-actions .btn-main { flex: 1; }

            /* RESPONSIVE */
            @media (max-width: 1000px) {
                .stats { grid-template-columns: repeat(2, 1fr); }
                .panels { grid-template-columns: 1fr; }
            }

            @media (max-width: 800px) {
                .layout { flex-direction: column; }
                .sidebar { position: static; width: 100%; height: auto; }
                .sidebar nav ul { display: flex; flex-wrap: wrap; gap: 4px; }
                .content { padding: 24px 16px 40px; }
                .topbar-search { display: none; }
            }


            /* SIDEBAR, LIGHTER MAUVE */
            .sidebar {
                background: linear-gradient(180deg, #B07A7B 0%, #A36869 100%);
                border-right: 0;
                box-shadow: 4px 0 24px rgba(59, 36, 24, .08);
            }

            .sidebar-header {
                background: transparent;
                border-bottom: 1px solid rgba(255, 255, 255, .32);
            }

            .sidebar-header img { filter: brightness(0) invert(1); }

            .admin-tag { background: #fff; color: var(--primary); }

            .sidebar nav a { color: #fff; }
            .sidebar nav a:hover { background: rgba(255, 255, 255, .18); color: #fff; }
            .sidebar nav a.active {
                background: #fff;
                color: var(--primary);
                font-weight: 800;
                box-shadow: 0 6px 16px rgba(0, 0, 0, .12);
            }

            /* LOGIN AND REGISTER PAGES */
            .auth-page {
                min-height: 100vh;
                padding: 40px 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--bg);
            }

            .auth-card {
                width: 100%;
                max-width: 440px;
                padding: 40px;
                border: 1px solid var(--border);
                border-radius: 24px;
                background: #fff;
                box-shadow: 0 24px 60px rgba(59, 36, 24, .10);
            }

            .auth-card--wide { max-width: 560px; }

            .auth-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 22px; }
            .auth-logo img { height: 32px; }

            .auth-logo span {
                padding: 3px 8px;
                border-radius: 6px;
                background: var(--secondary);
                color: var(--primary);
                font-size: 10px;
                font-weight: 800;
                letter-spacing: .6px;
            }

            .auth-card h1 {
                margin-bottom: 6px;
                font-family: var(--font-heading);
                font-size: 38px;
                font-weight: 600;
                line-height: 1;
            }

            .auth-sub { margin-bottom: 18px; color: var(--muted); font-size: 13px; }

            .auth-form label { display: block; margin: 14px 0 6px; color: var(--muted); font-size: 12px; font-weight: 700; }

            .auth-form input[type=text],
            .auth-form input[type=email],
            .auth-form input[type=tel],
            .auth-form input[type=password] {
                width: 100%;
                padding: 11px 13px;
                border: 1px solid #DED0CA;
                border-radius: 10px;
                outline: none;
                background: #fff;
                color: var(--text);
                font-family: var(--font-body);
                font-size: 13px;
            }

            .auth-form input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(155, 95, 96, .15); }
            .auth-form ul { margin: 6px 0 0; padding: 0; list-style: none; color: #9B3A3A; font-size: 12px; }

            .auth-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
            .auth-grid .full { grid-column: 1 / -1; }
            .auth-hint { margin-top: 6px; color: #8A7066; font-size: 11px; }

            .auth-check { display: flex; align-items: center; gap: 8px; margin-top: 14px; }
            .auth-check input { accent-color: var(--primary); }
            .auth-check label { margin: 0; font-weight: 500; }

            .auth-submit {
                width: 100%;
                margin-top: 20px;
                padding: 12px 16px;
                border: 0;
                border-radius: 50px;
                background: var(--primary);
                color: #fff;
                font-family: var(--font-body);
                font-size: 12px;
                font-weight: 800;
                letter-spacing: .4px;
                cursor: pointer;
                transition: opacity .2s ease;
            }

            .auth-submit:hover { opacity: .88; }

            .auth-error {
                margin-bottom: 14px;
                padding: 12px 14px;
                border-radius: 10px;
                background: #F6DADA;
                color: #9B3A3A;
                font-size: 13px;
                font-weight: 600;
            }

            .auth-note {
                margin-bottom: 14px;
                padding: 12px 14px;
                border-radius: 10px;
                background: var(--secondary);
                color: var(--primary);
                font-size: 13px;
                font-weight: 600;
            }

            .auth-switch { margin-top: 20px; font-size: 13px; }
            .auth-switch a, .auth-note a { color: var(--primary); font-weight: 700; }

            @media (max-width: 560px) {
                .auth-card { padding: 28px 22px; }
                .auth-grid { grid-template-columns: 1fr; }
            }


            :root {
                --primary-color: var(--primary);
                --primary-color-rgb: 155, 95, 96;
                --secondary-color: var(--secondary);
                --primary-bg-color: var(--bg);
                --font-color: var(--text);
                --font-color-rgb: 59, 36, 24;
            }

            .booking-modal .modal-dialog { max-width: 1180px; }
            .booking-modal .modal-content { padding: 30px; background: var(--bg); }
            .booking-modal form div { margin-bottom: 0; }

            .booking-modal .booking-form { display: flex; flex-direction: column; gap: 26px; }

            .booking-modal .booking-section {
                padding: 34px;
                border: 1px solid #D9C9C3;
                border-radius: 24px;
                background: #fff;
                box-shadow: 0 12px 34px rgba(var(--font-color-rgb), .055);
            }

            .booking-modal .booking-section-heading { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 28px; }

            .booking-modal .booking-section-heading > span {
                display: grid;
                place-items: center;
                width: 34px;
                height: 34px;
                flex: 0 0 34px;
                border-radius: 50%;
                background: var(--secondary-color);
                color: var(--font-color);
                font-size: 10px;
                font-weight: 800;
                letter-spacing: .5px;
            }

            .booking-modal .booking-section-heading h2 { margin: 0 0 4px; font-family: var(--font-heading); font-size: 30px; font-weight: 600; line-height: 1; }
            .booking-modal .booking-section-heading p { margin: 0; color: #765A50; font-size: 12px; line-height: 1.6; }

            .booking-modal .booking-service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }

            .booking-modal .booking-service-card {
                position: relative;
                min-height: 330px;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                border: 1px solid #DED0CA;
                border-radius: 18px;
                background: #FFFDFC;
                transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
            }

            .booking-modal .booking-service-card:hover,
            .booking-modal .booking-service-card.selected {
                transform: translateY(-3px);
                border-color: var(--primary-color);
                box-shadow: 0 12px 26px rgba(var(--primary-color-rgb), .12);
            }

            .booking-modal .service-card-main {
                position: relative;
                display: flex;
                flex: 1;
                flex-direction: column;
                align-items: flex-start;
                padding: 20px;
                border: 0;
                background: transparent;
                color: var(--font-color);
                font-weight: 400;
                text-align: left;
                cursor: pointer;
            }

            .booking-modal .service-card-img { align-self: stretch; height: 140px; margin: -20px -20px 14px; overflow: hidden; }
            .booking-modal .service-card-img img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
            .booking-modal .service-card-img-empty { display: flex; align-items: center; justify-content: center; background: var(--secondary-color); }
            .booking-modal .service-card-img-empty img { width: 70px; height: auto; object-fit: contain; opacity: .35; }

            .booking-modal .service-card-number { color: #A9897D; font-size: 9px; font-weight: 800; letter-spacing: .8px; }
            .booking-modal .service-card-title { margin: 6px 0 8px; font-family: var(--font-heading); font-size: 22px; font-weight: 600; line-height: 1.05; }

            .booking-modal .service-card-description {
                color: #765A50;
                font-size: 11px;
                line-height: 1.55;
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .booking-modal .service-card-bottom { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; width: 100%; margin-top: auto; padding-top: 15px; }
            .booking-modal .service-card-bottom strong { color: var(--primary-color); font-size: 14px; }
            .booking-modal .service-card-bottom span { color: #8A7066; font-size: 9px; font-weight: 700; }

            .booking-modal .booking-service-card.selected::after {
                content: "✓ SELECTED";
                position: absolute;
                top: 15px;
                right: 15px;
                padding: 5px 7px;
                border-radius: 20px;
                background: var(--primary-color);
                color: #fff;
                font-size: 7px;
                font-weight: 800;
                letter-spacing: .4px;
            }

            .booking-modal .selected-service-message { margin: 18px 0 0; padding: 12px 15px; border-radius: 10px; background: #F6E7E4; color: var(--font-color); font-size: 12px; }
            .booking-modal .selected-service-message i { margin-right: 5px; color: var(--primary-color); }

            .booking-modal .booking-details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }

            .booking-modal .form-group { display: flex; flex-direction: column; gap: 6px; }
            .booking-modal .form-group label { margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .3px; color: var(--font-color); }
            .booking-modal .form-group label span { color: #987D73; font-weight: 500; }

            .booking-modal .form-group input,
            .booking-modal .form-group select {
                width: 100%;
                max-width: none;
                min-height: 42px;
                padding: 0 14px;
                border: 1px solid #D5C5BF;
                border-radius: 10px;
                background: var(--primary-bg-color);
                color: var(--font-color);
                font-family: var(--font-body);
                font-size: 13px;
                outline: none;
                transition: border-color .2s ease;
            }

            .booking-modal .form-group textarea {
                width: 100%;
                max-width: none;
                min-height: 120px;
                padding: 14px;
                border: 1px solid #D5C5BF;
                border-radius: 10px;
                background: var(--primary-bg-color);
                color: var(--font-color);
                font-family: var(--font-body);
                font-size: 13px;
                resize: vertical;
                outline: none;
                transition: border-color .2s ease;
            }

            .booking-modal .form-group input:focus,
            .booking-modal .form-group select:focus,
            .booking-modal .form-group textarea:focus { border-color: var(--primary-color); }

            .booking-modal .payment-method-label { margin-bottom: 10px; font-size: 11px; font-weight: 700; letter-spacing: .3px; text-align: left; }
            .booking-modal .payment-method-select { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; text-align: left; }

            .booking-modal .payment-option {
                display: flex;
                align-items: flex-start;
                gap: 10px;
                margin: 0;
                padding: 12px 14px;
                border: 1px solid #D5C5BF;
                border-radius: 12px;
                color: var(--font-color);
                font-size: 13px;
                font-weight: 400;
                cursor: pointer;
                transition: border-color .2s ease, background .2s ease;
            }

            .booking-modal .payment-option:has(input:checked) { border-color: var(--primary-color); background: var(--primary-bg-color); }
            .booking-modal .payment-option input[type="radio"] { margin-top: 3px; }
            .booking-modal .payment-option-info { display: flex; flex-direction: column; gap: 2px; }
            .booking-modal .payment-option-info strong { font-size: 13px; }
            .booking-modal .payment-option-info span { color: #8A7066; font-size: 11px; }

            .booking-modal .booking-submit-area { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 8px 4px 0; }
            .booking-modal .booking-submit-area p { margin: 0; color: #765A50; font-size: 11px; }
            .booking-modal .booking-submit-area p i { margin-right: 5px; }
            .booking-modal .booking-submit { min-width: 220px; }

            @media (max-width: 1000px) {
                .booking-modal .booking-service-grid { grid-template-columns: repeat(2, 1fr); }
            }

            @media (max-width: 650px) {
                .booking-modal .booking-section { padding: 24px 20px; }
                .booking-modal .booking-service-grid,
                .booking-modal .booking-details-grid { grid-template-columns: 1fr; }
                .booking-modal .booking-submit-area { align-items: stretch; flex-direction: column; }
                .booking-modal .booking-submit { width: 100%; }
            }



        </style>
    </head>

        <body>

        {% block layout %}
            <div class="layout">

                {% include 'partials/sidebar.html.twig' %}

                <div class="main">

                    {% include 'partials/topbar.html.twig' %}

                    <main class="content">
                        {% for type, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="flash flash-{{ type }}">{{ message }}</div>
                            {% endfor %}
                        {% endfor %}

                        {% block body %}{% endblock %}
                    </main>

                    {% include 'partials/footer.html.twig' %}

                </div>

            </div>
        {% endblock %}

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}

    </body>

</html>