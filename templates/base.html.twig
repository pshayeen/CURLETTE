<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Admin | Curlétte{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/C-icon.png') }}" type="image/png">

        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">

        <style>
            /* Curlétte colors and fonts */
            :root {
                --bg: #FFF7F3;
                --primary: #9B5F60;
                --secondary: #E8C8C5;
                --text: #3B2418;
                --muted: #765A50;
                --border: #E7DAD5;
                --font-heading: 'Cormorant Garamond', Garamond, serif;
                --font-body: 'Manrope', sans-serif;
            }

            * { margin: 0; padding: 0; box-sizing: border-box; }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: var(--font-body);
            }

            a { color: inherit; text-decoration: none; }

            /* LAYOUT */
            .layout { display: flex; min-height: 100vh; }

            /* SIDEBAR */
            .sidebar {
                position: sticky;
                top: 0;
                width: 250px;
                height: 100vh;
                flex-shrink: 0;
                display: flex;
                flex-direction: column;
                padding: 0 18px 26px;
                background: #fff;
                border-right: 1px solid var(--border);
            }

            .sidebar-header {
                display: flex;
                align-items: center;
                gap: 10px;
                height: 68px;
                margin: 0 -18px 18px;
                padding: 0 26px;
                border-bottom: 1px solid var(--border);
            }

            .sidebar-header img { height: 30px; }

            .admin-tag {
                padding: 3px 8px;
                border-radius: 6px;
                background: var(--secondary);
                color: var(--primary);
                font-size: 10px;
                font-weight: 800;
                letter-spacing: .6px;
            }

            .sidebar nav { flex: 1; }
            .sidebar ul { list-style: none; }
            .sidebar li { margin-bottom: 4px; }

            .sidebar nav a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 11px 12px;
                border-radius: 10px;
                color: var(--muted);
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                transition: background .2s ease, color .2s ease;
            }

            .sidebar nav a:hover { background: var(--bg); color: var(--primary); }
            .sidebar nav a.active { background: var(--secondary); color: var(--primary); }

            .logout-btn {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                padding: 9px 16px;
                border-radius: 10px;
                background: var(--secondary);
                color: var(--primary);
                font-size: 12px;
                font-weight: 700;
                cursor: pointer;
                transition: background .2s ease, color .2s ease;
            }

            .logout-btn:hover { background: var(--primary); color: #fff; }

            /* CONTENT */
            .main {
                flex: 1;
                min-width: 0;
                display: flex;
                flex-direction: column;
            }

            .content { flex: 1; padding: 36px 32px 50px; }

            /* TOPBAR */
            .topbar {
                position: sticky;
                top: 0;
                z-index: 10;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                height: 68px;
                padding: 0 32px;
                background: #fff;
                border-bottom: 1px solid var(--border);
            }

            .topbar-search {
                display: flex;
                align-items: center;
                gap: 8px;
                width: 280px;
                padding: 9px 14px;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: var(--bg);
                color: var(--muted);
            }

            .topbar-search input {
                flex: 1;
                border: 0;
                outline: none;
                background: transparent;
                color: var(--text);
                font-family: var(--font-body);
                font-size: 13px;
            }

            .topbar-actions { display: flex; align-items: center; gap: 18px; }

            .topbar-link {
                color: var(--muted);
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
            }

            .topbar-link:hover { color: var(--primary); }

            /* FOOTER */
            .footer {
                display: flex;
                justify-content: space-between;
                padding: 18px 32px;
                border-top: 1px solid var(--border);
                background: #fff;
                color: var(--muted);
                font-size: 12px;
            }

            /* PAGE HEADER */
            .page-header { margin-bottom: 28px; }

            .page-header h1 {
                font-family: var(--font-heading);
                font-size: 34px;
                font-weight: 600;
            }

            .page-header p {
                margin-top: 4px;
                color: var(--muted);
                font-size: 13px;
            }

            .page-header-row {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 20px;
            }

            /* STAT CARDS (dashboard) */
            .stats {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 18px;
                margin-bottom: 34px;
            }

            .stat-card {
                padding: 20px;
                border: 1px solid var(--border);
                border-radius: 18px;
                background: #fff;
                transition: transform .2s ease, box-shadow .2s ease;
            }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 26px rgba(59, 36, 24, .08);
            }

            .stat-icon {
                display: grid;
                place-items: center;
                width: 36px;
                height: 36px;
                margin-bottom: 12px;
                border-radius: 50%;
                background: var(--secondary);
                color: var(--primary);
                font-size: 16px;
            }

            .stat-card strong {
                display: flex;
                align-items: center;
                height: 34px;
                font-family: var(--font-heading);
                font-size: 30px;
                font-weight: 700;
                line-height: 1.1;
            }

            .stat-card.money strong { font-size: 24px; }
            .stat-card.alert strong { color: #9B3A3A; }

            .stat-card span {
                display: block;
                margin-top: 6px;
                color: var(--muted);
                font-size: 11px;
                font-weight: 700;
                letter-spacing: .3px;
                text-transform: uppercase;
            }

            /* PANELS (dashboard) */
            .panels {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 24px;
            }

            .panel {
                padding: 26px;
                border: 1px solid var(--border);
                border-radius: 20px;
                background: #fff;
            }

            .panel h2 {
                margin-bottom: 16px;
                font-family: var(--font-heading);
                font-size: 20px;
                font-weight: 700;
            }

            .row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 12px 0;
                border-bottom: 1px solid #F1E6E1;
                font-size: 13px;
            }

            .row:last-of-type { border-bottom: 0; }
            .row strong { display: block; }
            .row small { color: #8A7066; font-size: 11px; }

            .panel-footer {
                margin-top: 16px;
                padding-top: 16px;
                border-top: 1px solid #F1E6E1;
                font-size: 12px;
            }

            /* STATUS BADGES */
            .badge {
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: .3px;
                text-transform: uppercase;
            }

            .badge.placed     { background: var(--secondary); color: var(--primary); }
            .badge.processing { background: #FBE8CE; color: #B4720A; }
            .badge.fulfilled  { background: #DCEFE1; color: #2F7D4F; }
            .badge.cancelled  { background: #F6DADA; color: #9B3A3A; }
            .badge.upcoming   { background: var(--secondary); color: var(--primary); }
            .badge.completed  { background: #DCEFE1; color: #2F7D4F; }

            /* TABLES */
            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
                background: #fff;
                border: 1px solid var(--border);
            }

            th {
                padding: 14px 16px;
                border-bottom: 1px solid var(--border);
                background: var(--bg);
                color: var(--muted);
                font-size: 10px;
                font-weight: 800;
                letter-spacing: .5px;
                text-transform: uppercase;
                text-align: left;
            }

            td { padding: 12px 16px; border-bottom: 1px solid #F1E6E1; vertical-align: middle; }
            tbody tr:hover { background: var(--bg); }

            .table-wrap {
                overflow-x: auto;
                border: 1px solid var(--border);
                border-radius: 20px;
                background: #fff;
            }

            .table-wrap table { border: 0; }
            .table-wrap tr:last-child td { border-bottom: 0; }

            .muted {
                display: block;
                margin-top: 2px;
                color: #8A7066;
                font-size: 11px;
                font-weight: 500;
            }

            .stock-low { color: #9B3A3A; font-weight: 800; }

            .section-title {
                margin: 34px 0 14px;
                font-family: var(--font-heading);
                font-size: 22px;
                font-weight: 700;
            }

            /* FORMS */
            .content form div { margin-bottom: 14px; }

            .content label {
                display: block;
                margin-bottom: 6px;
                color: var(--muted);
                font-size: 12px;
                font-weight: 700;
            }

            .content input[type=text], .content input[type=number], .content input[type=email],
            .content input[type=date], .content input[type=time], .content select, .content textarea {
                width: 100%;
                max-width: 480px;
                padding: 10px 12px;
                border: 1px solid #DED0CA;
                border-radius: 10px;
                background: #fff;
                font-family: var(--font-body);
                font-size: 13px;
            }

            .content .form-control {
                width: 100%;
                max-width: 100%;
                padding: 10px 12px;
                border: 1px solid #DED0CA;
                border-radius: 10px;
                background: #fff;
                font-family: var(--font-body);
                font-size: 13px;
            }

            .content form ul { margin: 0 0 6px; padding: 0; list-style: none; color: #9B3A3A; font-size: 12px; }

            .form-card {
                max-width: 560px;
                padding: 28px;
                border: 1px solid var(--border);
                border-radius: 20px;
                background: #fff;
            }

            .form-back { margin-top: 18px; font-size: 12px; }

            .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
            .form-grid .full { grid-column: 1 / -1; }

            /* BUTTONS AND LINKS */
            .content button {
                padding: 9px 16px;
                border: 0;
                border-radius: 10px;
                background: var(--primary);
                color: #fff;
                font-family: var(--font-body);
                font-size: 12px;
                font-weight: 700;
                cursor: pointer;
            }

            .content a { color: var(--primary); font-weight: 700; }

            .content .view-link { color: var(--primary); font-size: 12px; font-weight: 700; }
            .content .view-link:hover { text-decoration: underline; }

            .content .btn-main,
            .content .btn-outline {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 38px;
                padding: 0 24px;
                border-radius: 50px;
                font-size: 12px;
                font-weight: 700;
                transition: .25s ease;
            }

            .content .btn-main { border: 0; background: var(--primary); color: var(--bg); }
            .content .btn-main:hover { opacity: .88; }
            .content .btn-outline { border: 2px solid var(--primary); background: transparent; color: var(--primary); }
            .content .btn-outline:hover { background: var(--primary); color: #fff; }
            .content .btn-main.is-danger { background: #9B3A3A; }
            .content .btn-main.is-danger:hover { background: #7d2e2e; opacity: 1; }

            .content .btn-small,
            .content .btn-small-danger {
                padding: 6px 12px;
                border-radius: 8px;
                font-size: 11px;
                font-weight: 700;
                white-space: nowrap;
            }

            .content .btn-small { border: 1px solid #DED0CA; background: #fff; color: var(--text); }
            .content .btn-small:hover { border-color: var(--primary); color: var(--primary); }
            .content .btn-small-danger { border: 0; background: #F6DADA; color: #9B3A3A; }
            .content .btn-small-danger:hover { background: #9B3A3A; color: #fff; }

            /* TABLE ROW HELPERS (Products page) */
            .row-actions { display: flex; align-items: center; gap: 12px; }
            .content .row-actions .view-link { margin-right: 0; }

            .inline-form { display: flex; align-items: center; gap: 6px; margin: 0; white-space: nowrap; }
            .inline-form span { color: #8A7066; font-size: 11px; font-weight: 700; }

            .content .inline-form input[type=number] {
                width: 80px;
                max-width: none;
                padding: 6px 8px;
                border-radius: 8px;
                background: var(--bg);
                font-size: 12px;
            }

            .content .inline-form.stock input[type=number] { width: 64px; }

            /* FLASH MESSAGES */
            .flash {
                margin-bottom: 20px;
                padding: 12px 16px;
                border-radius: 12px;
                font-size: 13px;
                font-weight: 600;
            }

            .flash-success { background: #DCEFE1; color: #2F7D4F; }
            .flash-danger  { background: #F6DADA; color: #9B3A3A; }

            /* MODALS (Bootstrap's JavaScript runs them, this styling is ours) */
            .fade { transition: opacity .15s linear; }
            .fade:not(.show) { opacity: 0; }

            .modal {
                position: fixed;
                top: 0;
                left: 0;
                z-index: 1055;
                display: none;
                width: 100%;
                height: 100%;
                overflow-x: hidden;
                overflow-y: auto;
                outline: 0;
            }

            .modal-dialog {
                position: relative;
                width: calc(100% - 32px);
                max-width: 480px;
                margin: 32px auto;
                pointer-events: none;
            }

            .modal.fade .modal-dialog { transform: translateY(-30px); transition: transform .25s ease-out; }
            .modal.show .modal-dialog { transform: none; }
            .modal-dialog-centered { display: flex; align-items: center; min-height: calc(100% - 64px); }

            .modal-content {
                position: relative;
                display: flex;
                flex-direction: column;
                width: 100%;
                padding: 32px 34px;
                border: 0;
                border-radius: 24px;
                background: #fff;
                box-shadow: 0 24px 60px rgba(59, 36, 24, .25);
                pointer-events: auto;
            }

            .modal-backdrop {
                position: fixed;
                top: 0;
                left: 0;
                z-index: 1050;
                width: 100vw;
                height: 100vh;
                background: #3B2418;
            }

            .modal-backdrop.fade { opacity: 0; }
            .modal-backdrop.show { opacity: .45; }

            .modal-heading h2 { margin-bottom: 6px; font-family: var(--font-heading); font-size: 28px; font-weight: 600; }
            .modal-heading p { margin-bottom: 22px; color: var(--muted); font-size: 13px; }
            .modal-actions { display: flex; gap: 12px; margin-top: 8px; }

            .content .modal-heading, .content .modal-actions { margin-bottom: 0; }
            .content .modal-actions .btn-outline, .content .modal-actions .btn-main { flex: 1; }

            .content .modal input[type=text], .content .modal input[type=number], .content .modal input[type=email],
            .content .modal input[type=date], .content .modal input[type=time], .content .modal select, .content .modal textarea {
                max-width: 100%;
            }

            .confirm-modal-content { padding: 40px 36px; text-align: center; }

            .confirm-modal-icon {
                display: grid;
                place-items: center;
                width: 56px;
                height: 56px;
                margin: 0 auto 18px;
                border-radius: 50%;
                background: var(--secondary);
                color: var(--primary);
                font-size: 24px;
            }

            .confirm-modal-content.danger .confirm-modal-icon { background: #F6DADA; color: #9B3A3A; }
            .confirm-modal-content h2 { margin-bottom: 8px; font-family: var(--font-heading); font-size: 26px; font-weight: 600; }
            .confirm-modal-content p { margin-bottom: 26px; color: var(--muted); font-size: 13px; line-height: 1.6; }
            .confirm-modal-actions { display: flex; gap: 12px; }
            .content .confirm-modal-actions { margin-bottom: 0; }
            .content .confirm-modal-actions .btn-outline, .content .confirm-modal-actions .btn-main { flex: 1; }

            /* RESPONSIVE */
            @media (max-width: 1000px) {
                .stats { grid-template-columns: repeat(2, 1fr); }
                .panels { grid-template-columns: 1fr; }
            }

            @media (max-width: 800px) {
                .layout { flex-direction: column; }
                .sidebar { position: static; width: 100%; height: auto; }
                .sidebar nav ul { display: flex; flex-wrap: wrap; gap: 4px; }
                .content { padding: 24px 16px 40px; }
                .topbar-search { display: none; }
            }
        </style>
    </head>

    <body>

        <div class="layout">

            {% include 'partials/sidebar.html.twig' %}

            <div class="main">

                {% include 'partials/topbar.html.twig' %}

                <main class="content">
                    {% for type, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="flash flash-{{ type }}">{{ message }}</div>
                        {% endfor %}
                    {% endfor %}

                    {% block body %}{% endblock %}
                </main>

                {% include 'partials/footer.html.twig' %}

            </div>

        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}

    </body>

</html>