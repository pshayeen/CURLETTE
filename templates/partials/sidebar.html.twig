{% set current = app.request.attributes.get('_route') %}

<aside class="sidebar">

    <div class="sidebar-header">
        <img src="{{ asset('images/logo.png') }}" alt="Curlétte">
        <span class="admin-tag">ADMIN</span>
    </div>

    <nav>
        <ul>
            <li>
                <a href="{{ path('app_dashboard') }}" class="{{ current == 'app_dashboard' or current == 'app_home' ? 'active' }}">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li>
                <a href="{{ path('app_orders_index') }}" class="{{ current starts with 'app_orders' ? 'active' }}">
                    <i class="bi bi-bag-check"></i> Orders
                </a>
            </li>
            <li>
                <a href="{{ path('app_appointments_index') }}" class="{{ current starts with 'app_appointments' ? 'active' }}">
                    <i class="bi bi-calendar-check"></i> Appointments
                </a>
            </li>
            <li>
                <a href="{{ path('app_products_index') }}" class="{{ current starts with 'app_products' ? 'active' }}">
                    <i class="bi bi-box-seam"></i> Products
                </a>
            </li>
            <li>
                <a href="{{ path('app_services_index') }}" class="{{ current starts with 'app_services' ? 'active' }}">
                    <i class="bi bi-scissors"></i> Services
                </a>
            </li>
            <li>
                <a href="{{ path('app_users_index') }}" class="{{ current starts with 'app_users' ? 'active' }}">
                    <i class="bi bi-people"></i> Users
                </a>
            </li>
            <li>
                <a href="{{ path('app_messages_index') }}" class="{{ current starts with 'app_messages' ? 'active' }}">
                    <i class="bi bi-envelope"></i> Messages
                </a>
            </li>
        </ul>
    </nav>

</aside>