<header class="topbar">

    <div class="topbar-search">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search...">
    </div>

    <div class="topbar-actions">
        <a href="{{ path('app_profile') }}" class="topbar-link">
            Hi, {{ app.user ? (app.user.fullName|default(app.user.userIdentifier))|split(' ')|first : 'there' }}
        </a>
        <a href="{{ path('app_logout') }}" class="logout-btn"><i class="bi bi-box-arrow-right"></i> Log Out</a>
    </div>

</header>