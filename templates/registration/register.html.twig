{% extends 'base_site.html.twig' %}

{% block title %}Sign up | Curlétte Hair Studio{% endblock %}

{% block body %}

    <section class="sign-page">
        <div class="sign-shell">

            <aside class="sign-aside">
                <img src="{{ asset('images/salon.jpg') }}" alt="" class="sign-aside-bg">
                <div class="sign-aside-text">
                    <p class="home-label">JOIN CURLÉTTE</p>
                    <h2>Your curls,<br><em>your account.</em></h2>
                </div>
            </aside>

            <div class="sign-main">
                <a href="{{ path('app_home') }}" class="sign-brand">
                    <img src="{{ asset('images/logo.png') }}" alt="Curlétte Hair Studio">
                </a>

                <h1>Create your account</h1>
                <p class="sign-sub">It takes a minute, then you can book and shop.</p>

                {{ form_start(registrationForm, {attr: {class: 'sign-form', novalidate: 'novalidate'}}) }}
                    <div class="sign-grid">
                        <div class="form-group sign-full">
                            {{ form_label(registrationForm.fullName) }}
                            {{ form_widget(registrationForm.fullName) }}
                            {{ form_errors(registrationForm.fullName) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(registrationForm.username) }}
                            {{ form_widget(registrationForm.username) }}
                            {{ form_errors(registrationForm.username) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(registrationForm.email) }}
                            {{ form_widget(registrationForm.email) }}
                            {{ form_errors(registrationForm.email) }}
                        </div>
                        <div class="form-group sign-full">
                            {{ form_label(registrationForm.phoneNumber) }}
                            {{ form_widget(registrationForm.phoneNumber) }}
                            {{ form_errors(registrationForm.phoneNumber) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(registrationForm.plainPassword.first) }}
                            {{ form_widget(registrationForm.plainPassword.first) }}
                            {{ form_errors(registrationForm.plainPassword.first) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(registrationForm.plainPassword.second) }}
                            {{ form_widget(registrationForm.plainPassword.second) }}
                            {{ form_errors(registrationForm.plainPassword.second) }}
                        </div>
                        <p class="sign-help sign-full">Use at least 8 characters, including an uppercase letter, a lowercase letter, a number and a special character.</p>
                    </div>

                    <div class="sign-check-block">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        {{ form_label(registrationForm.agreeTerms) }}
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>

                    <button type="submit" class="btn-main sign-submit">CREATE ACCOUNT</button>
                {{ form_end(registrationForm) }}

                <p class="sign-switch">Already have an account? <a href="{{ path('app_login') }}">Log in</a></p>
            </div>

        </div>
    </section>

{% endblock %}
