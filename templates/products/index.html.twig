{% extends 'base.html.twig' %}

{% block title %}Products | Curlétte Admin{% endblock %}

{% block body %}

    <div class="page-header page-header-row">
        <div>
            <h1>Products</h1>
            <p>{{ products|length }} product{{ products|length == 1 ? '' : 's' }} in the catalog.</p>
        </div>
        <a href="{{ path('app_products_new') }}" class="btn-main">+ ADD PRODUCT</a>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    <tr>
                        <td>
                            <strong>{{ product.productName }}</strong>
                            <span class="muted">{{ product.productDescription|slice(0, 60) }}{{ product.productDescription|length > 60 ? '…' }}</span>
                        </td>
                        <td><strong>PHP {{ product.price|number_format(2) }}</strong></td>
                        <td>
                            <span class="{{ product.stockQuantity <= 5 ? 'stock-low' }}">
                                {{ product.stockQuantity }}{{ product.stockQuantity <= 5 ? ' (low)' }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('app_products_show', {id: product.id}) }}" class="view-link">View</a>
                            <a href="{{ path('app_products_edit', {id: product.id}) }}" class="view-link">Edit</a>
                            {{ include('products/_delete_form.html.twig') }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4"><span class="muted">No products yet.</span></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}