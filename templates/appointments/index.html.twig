{% extends 'base.html.twig' %}

{% block title %}Appointments | Curlétte Admin{% endblock %}

{% block body %}

    {% set paymentLabels = {cash: 'Cash', gcash: 'GCash', bank: 'Bank Transfer'} %}

    <div class="page-header page-header-row">
        <div>
            <h1>Appointments</h1>
            <p>{{ appointments|length }} appointment{{ appointments|length == 1 ? '' : 's' }}{{ term or status ? ' found' : ' in total' }}.</p>
        </div>
        <a href="{{ path('app_appointments_new') }}" class="btn-main">+ ADD APPOINTMENT</a>
    </div>

    <div style="margin-bottom: 16px;">
        <form method="get" action="{{ path('app_appointments_index') }}" class="inline-form">
            <input type="text" name="q" value="{{ term }}" placeholder="Search by customer, email or service..." style="width: 280px;">
            <select name="status" style="width: 160px;">
                <option value="">All statuses</option>
                {% for value, label in {upcoming: 'Upcoming', completed: 'Completed', cancelled: 'Cancelled'} %}
                    <option value="{{ value }}"{{ status == value ? ' selected' }}>{{ label }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn-small">Filter</button>
            {% if term or status %}
                <a href="{{ path('app_appointments_index') }}" class="view-link">Clear</a>
            {% endif %}
        </form>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Booking</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Date &amp; Time</th>
                    <th>Deposit</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for appointment in appointments %}
                    <tr>
                        <td><strong>#{{ appointment.id }}</strong></td>
                        <td>
                            <strong>{{ appointment.customerName }}</strong>
                            <span class="muted">{{ appointment.customerEmail }}</span>
                            {% if appointment.customerPhone %}<span class="muted">{{ appointment.customerPhone }}</span>{% endif %}
                        </td>
                        <td>{{ appointment.service }}</td>
                        <td>
                            {{ appointment.appointmentDate ? appointment.appointmentDate|date('M j, Y') : '—' }}
                            <span class="muted">{{ appointment.appointmentTime ? appointment.appointmentTime|date('g:i A') : '' }}</span>
                        </td>
                        <td>
                            <strong>PHP {{ appointment.depositAmount|number_format(2) }}</strong>
                            <span class="muted">
                                {{ paymentLabels[appointment.paymentMethod]|default(appointment.paymentMethod) }}{% if appointment.paymentReference %} · Ref #{{ appointment.paymentReference }}{% endif %}
                            </span>
                        </td>
                        <td class="source-cell">
                            {% if appointment.createdBy %}
                                <span class="badge walkin">Walk-in</span>
                                <span class="muted">by {{ appointment.createdBy.fullName|default(appointment.createdBy.username) }}</span>
                            {% elseif appointment.customer %}
                                <span class="badge online">Online</span>
                            {% else %}
                                <span class="muted">—</span>
                            {% endif %}
                        </td>
                        <td><span class="badge {{ appointment.status }}">{{ appointment.status }}</span></td>
                        <td>
                            <div class="row-actions">
                                {% if is_granted('RECORD_EDIT', appointment) %}
                                    <a href="{{ path('app_appointments_edit', {id: appointment.id}) }}" class="view-link">Edit</a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8"><span class="muted">{{ term or status ? 'No appointments match your search.' : 'No appointments yet.' }}</span></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <h2 class="section-title">Upcoming</h2>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Booking</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Date &amp; Time</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for appointment in upcomingAppointments %}
                    <tr>
                        <td><strong>#{{ appointment.id }}</strong></td>
                        <td>{{ appointment.customerName }}</td>
                        <td>{{ appointment.service }}</td>
                        <td>
                            {{ appointment.appointmentDate ? appointment.appointmentDate|date('M j, Y') : '—' }}
                            <span class="muted">{{ appointment.appointmentTime ? appointment.appointmentTime|date('g:i A') : '' }}</span>
                        </td>
                        <td>
                            {% if is_granted('RECORD_EDIT', appointment) %}
                                <a href="{{ path('app_appointments_edit', {id: appointment.id}) }}" class="view-link">Edit</a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5"><span class="muted">No upcoming appointments.</span></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}