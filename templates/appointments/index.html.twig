{% extends 'base.html.twig' %}

{% block title %}Appointments | Curlétte Admin{% endblock %}

{% block body %}

    {% set paymentLabels = {cash: 'Cash on Delivery', gcash: 'GCash', bank: 'Bank Transfer'} %}

    <div class="page-header page-header-row">
        <div>
            <h1>Appointments</h1>
            <p>{{ appointments|length }} appointment{{ appointments|length == 1 ? '' : 's' }} in total.</p>
        </div>
        <button type="button" class="btn-main" data-bs-toggle="modal" data-bs-target="#addAppointmentModal">
            + ADD APPOINTMENT
        </button>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Booking</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Date &amp; Time</th>
                    <th>Notes</th>
                    <th>Deposit</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for appointment in appointments %}
                    <tr>
                        <td><strong>#{{ appointment.id }}</strong></td>
                        <td>
                            <strong>{{ appointment.customerName }}</strong>
                            <span class="muted">{{ appointment.customerEmail }}</span>
                        </td>
                        <td>{{ appointment.service }}</td>
                        <td>
                            {{ appointment.appointmentDate ? appointment.appointmentDate|date('M j, Y') : '—' }}
                            <span class="muted">{{ appointment.appointmentTime ? appointment.appointmentTime|date('g:i A') : '' }}</span>
                        </td>
                        <td>
                            {{ appointment.notes ? (appointment.notes|slice(0, 40) ~ (appointment.notes|length > 40 ? '…' : '')) : '—' }}
                        </td>
                        <td>
                            <strong>PHP {{ appointment.depositAmount|number_format(2) }}</strong>
                            <span class="muted">
                                {{ paymentLabels[appointment.paymentMethod]|default(appointment.paymentMethod) }}{% if appointment.paymentReference %} · Ref #{{ appointment.paymentReference }}{% endif %}
                            </span>
                        </td>
                        <td><span class="badge {{ appointment.status }}">{{ appointment.status }}</span></td>
                        <td>
                            <div class="row-actions">
                                <a href="{{ path('app_appointments_show', {id: appointment.id}) }}" class="view-link">Show</a>
                                <a href="{{ path('app_appointments_edit', {id: appointment.id}) }}" class="view-link">Edit</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8"><span class="muted">No appointments yet.</span></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <h2 class="section-title">Upcoming</h2>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Booking</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Date &amp; Time</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for appointment in upcomingAppointments %}
                    <tr>
                        <td><strong>#{{ appointment.id }}</strong></td>
                        <td>{{ appointment.customerName }}</td>
                        <td>{{ appointment.service }}</td>
                        <td>
                            {{ appointment.appointmentDate ? appointment.appointmentDate|date('M j, Y') : '—' }}
                            <span class="muted">{{ appointment.appointmentTime ? appointment.appointmentTime|date('g:i A') : '' }}</span>
                        </td>
                        <td><a href="{{ path('app_appointments_edit', {id: appointment.id}) }}" class="view-link">Edit</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5"><span class="muted">No upcoming appointments.</span></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% set paymentHelp = {gcash: 'Pay the deposit via GCash.', bank: 'Pay the deposit via bank transfer.', cash: 'The deposit was paid in cash.'} %}

    <div class="modal fade booking-modal" id="addAppointmentModal" tabindex="-1" aria-labelledby="addAppointmentLabel" aria-hidden="true"
         data-open-on-load="{{ openAddModal|default(false) ? 'true' : 'false' }}">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-heading">
                    <h2 id="addAppointmentLabel">Book an appointment</h2>
                    <p>Choose the service, then pick a date and time for the customer.</p>
                </div>

                {{ form_start(form, {attr: {class: 'booking-form', id: 'bookingForm'}}) }}

                    <section class="booking-section">
                        <div class="booking-section-heading">
                            <span>01</span>
                            <div>
                                <h2>Customer details</h2>
                                <p>Who is this booking for?</p>
                            </div>
                        </div>
                        <div class="booking-details-grid">
                            <div class="form-group">
                                {{ form_label(form.customerName) }}
                                {{ form_widget(form.customerName) }}
                                {{ form_errors(form.customerName) }}
                            </div>
                            <div class="form-group">
                                {{ form_label(form.customerEmail) }}
                                {{ form_widget(form.customerEmail) }}
                                {{ form_errors(form.customerEmail) }}
                            </div>
                        </div>
                    </section>

                    <section class="booking-section">
                        <div class="booking-section-heading">
                            <span>02</span>
                            <div>
                                <h2>Choose a service</h2>
                                <p>Click a service to select it.</p>
                            </div>
                        </div>

                        {{ form_widget(form.service, {attr: {hidden: 'hidden', 'data-service-field': ''}}) }}
                        {{ form_errors(form.service) }}

                        <div class="booking-service-grid">
                            {% for service in services %}
                                <article class="booking-service-card{{ form.service.vars.value == service.serviceName ? ' selected' }}" data-service-card="{{ service.serviceName }}">
                                    <button type="button" class="service-card-main" data-service-select="{{ service.serviceName }}">
                                        {% if service.image %}
                                            <div class="service-card-img">
                                                <img src="{{ asset('images/services/' ~ service.image) }}" alt="{{ service.serviceName }}">
                                            </div>
                                        {% else %}
                                            <div class="service-card-img service-card-img-empty">
                                                <img src="{{ asset('images/C-icon.png') }}" alt="">
                                            </div>
                                        {% endif %}
                                        <span class="service-card-number">0{{ loop.index }}</span>
                                        <span class="service-card-title">{{ service.serviceName }}</span>
                                        <span class="service-card-description">{{ service.serviceDescription }}</span>
                                        <span class="service-card-bottom">
                                            <strong>PHP {{ service.price|number_format(0) }}</strong>
                                            <span>{{ service.duration }}</span>
                                        </span>
                                    </button>
                                </article>
                            {% endfor %}
                        </div>

                        <p class="selected-service-message" id="selectedServiceMessage"{% if not form.service.vars.value %} hidden{% endif %}>
                            <i class="bi bi-check-circle"></i> Selected: <strong>{{ form.service.vars.value }}</strong>
                        </p>
                    </section>

                    <section class="booking-section">
                        <div class="booking-section-heading">
                            <span>03</span>
                            <div>
                                <h2>Choose your schedule</h2>
                                <p>Pick a date and time that works best for the customer.</p>
                            </div>
                        </div>
                        <div class="booking-details-grid">
                            <div class="form-group">
                                {{ form_label(form.appointmentDate) }}
                                {{ form_widget(form.appointmentDate) }}
                                {{ form_errors(form.appointmentDate) }}
                            </div>
                            <div class="form-group">
                                {{ form_label(form.appointmentTime) }}
                                {{ form_widget(form.appointmentTime) }}
                                {{ form_errors(form.appointmentTime) }}
                            </div>
                        </div>
                    </section>

                    <section class="booking-section">
                        <div class="booking-section-heading">
                            <span>04</span>
                            <div>
                                <h2>Anything we should know?</h2>
                                <p>Optional — hair goals or special requests.</p>
                            </div>
                        </div>
                        <div class="form-group">
                            {{ form_label(form.notes) }}
                            {{ form_widget(form.notes) }}
                            {{ form_errors(form.notes) }}
                        </div>
                    </section>

                    <section class="booking-section">
                        <div class="booking-section-heading">
                            <span>05</span>
                            <div>
                                <h2>Secure the slot.</h2>
                                <p>A PHP {{ depositAmount|number_format(2) }} deposit is required to confirm the booking.</p>
                            </div>
                        </div>

                        <div class="payment-method-select">
                            <p class="payment-method-label">Payment Method</p>
                            {% for child in form.paymentMethod %}
                                <label class="payment-option">
                                    {{ form_widget(child) }}
                                    <span class="payment-option-info">
                                        <strong>{{ child.vars.label }}</strong>
                                        <span>{{ paymentHelp[child.vars.value]|default('') }}</span>
                                    </span>
                                </label>
                            {% endfor %}
                            {{ form_errors(form.paymentMethod) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.paymentReference) }}
                            {{ form_widget(form.paymentReference) }}
                            {{ form_errors(form.paymentReference) }}
                        </div>
                    </section>

                    <div class="booking-submit-area">
                        <p><i class="bi bi-info-circle"></i> The appointment is saved after confirmation.</p>
                        <div style="display: flex; gap: 12px;">
                            <button type="button" class="btn-outline" data-bs-dismiss="modal">CANCEL</button>
                            <button type="submit" class="btn-main booking-submit">CONFIRM BOOKING <i class="bi bi-arrow-right" style="margin-left: 6px;"></i></button>
                        </div>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
<script>
    const addModal = document.getElementById('addAppointmentModal');

    if (addModal.dataset.openOnLoad === 'true') {
        new bootstrap.Modal(addModal).show();
    }

    const serviceField = addModal.querySelector('[data-service-field]');
    const selectedMessage = document.getElementById('selectedServiceMessage');

    function selectService(name) {
        serviceField.value = name;

        addModal.querySelectorAll('[data-service-card]').forEach(function (card) {
            card.classList.toggle('selected', card.dataset.serviceCard === name);
        });

        selectedMessage.innerHTML = '<i class="bi bi-check-circle"></i> Selected: <strong></strong>';
        selectedMessage.querySelector('strong').textContent = name;
        selectedMessage.hidden = false;
    }

    addModal.querySelectorAll('[data-service-select]').forEach(function (button) {
        button.addEventListener('click', function () {
            selectService(button.dataset.serviceSelect);
        });
    });

    document.getElementById('bookingForm').addEventListener('submit', function (event) {
        if (!serviceField.value) {
            event.preventDefault();
            selectedMessage.innerHTML = '<i class="bi bi-exclamation-circle"></i> Please choose a service first.';
            selectedMessage.hidden = false;
            selectedMessage.scrollIntoView({behavior: 'smooth', block: 'center'});
        }
    });
</script>
{% endblock %}