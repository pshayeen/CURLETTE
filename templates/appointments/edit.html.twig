{% extends 'base.html.twig' %}

{% block title %}Edit Appointment | Curlétte Admin{% endblock %}

{% block body %}

    <div class="page-header">
        <h1>Edit Appointment #{{ appointment.id }}</h1>
        <p>{{ appointment.customerName }}</p>
    </div>

    <div class="form-card">
        {{ include('appointments/_form.html.twig', {button_label: 'Save Changes'}) }}
        <p class="form-back"><a href="{{ path('app_appointments_index') }}">← Back to appointments</a></p>
    </div>

    <div style="margin-top: 20px;">
        {{ include('appointments/_delete_form.html.twig') }}
    </div>

{% endblock %}