{% extends 'base.html.twig' %}

{% block title %}Appointments{% endblock %}

{% block body %}
    <h1>Appointments</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ appointment.id }}</td>
            </tr>
            <tr>
                <th>CustomerName</th>
                <td>{{ appointment.customerName }}</td>
            </tr>
            <tr>
                <th>CustomerEmail</th>
                <td>{{ appointment.customerEmail }}</td>
            </tr>
            <tr>
                <th>Service</th>
                <td>{{ appointment.service }}</td>
            </tr>
            <tr>
                <th>AppointmentDate</th>
                <td>{{ appointment.appointmentDate ? appointment.appointmentDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>AppointmentTime</th>
                <td>{{ appointment.appointmentTime ? appointment.appointmentTime|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Notes</th>
                <td>{{ appointment.notes }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ appointment.status }}</td>
            </tr>
            <tr>
                <th>DepositAmount</th>
                <td>{{ appointment.depositAmount }}</td>
            </tr>
            <tr>
                <th>PaymentReference</th>
                <td>{{ appointment.paymentReference }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ appointment.createdAt ? appointment.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_appointments_index') }}">back to list</a>

    <a href="{{ path('app_appointments_edit', {'id': appointment.id}) }}">edit</a>

    {{ include('appointments/_delete_form.html.twig') }}
{% endblock %}
