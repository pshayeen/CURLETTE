{% extends 'base.html.twig' %}

{% block title %}Appointment #{{ appointment.id }} | Curlétte Admin{% endblock %}

{% block body %}

    <div class="page-header page-header-row">
        <div>
            <h1>Appointment #{{ appointment.id }}</h1>
            <p>Booked on {{ appointment.createdAt ? appointment.createdAt|date('M j, Y') : '—' }}</p>
        </div>
        <span class="badge {{ appointment.status }}">{{ appointment.status }}</span>
    </div>

    <div class="table-wrap">
        <table>
            <tbody>
                <tr>
                    <th>Customer</th>
                    <td>{{ appointment.customerName }}</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>{{ appointment.customerEmail }}</td>
                </tr>
                <tr>
                    <th>Service</th>
                    <td>{{ appointment.service }}</td>
                </tr>
                <tr>
                    <th>Date</th>
                    <td>{{ appointment.appointmentDate ? appointment.appointmentDate|date('M j, Y') : '—' }}</td>
                </tr>
                <tr>
                    <th>Time</th>
                    <td>{{ appointment.appointmentTime ? appointment.appointmentTime|date('g:i A') : '—' }}</td>
                </tr>
                <tr>
                    <th>Notes</th>
                    <td>{{ appointment.notes ?: '—' }}</td>
                </tr>
                <tr>
                    <th>Deposit</th>
                    <td><strong>PHP {{ appointment.depositAmount|number_format(2) }}</strong></td>
                </tr>
                <tr>
                    <th>Payment method</th>
                    <td>{{ appointment.paymentMethod }}</td>
                </tr>
                <tr>
                    <th>Payment reference</th>
                    <td>{{ appointment.paymentReference ?: '—' }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="row-actions" style="margin-top: 20px;">
        <a href="{{ path('app_appointments_index') }}" class="view-link">← Back to appointments</a>
        <a href="{{ path('app_appointments_edit', {id: appointment.id}) }}" class="view-link">Edit</a>
        {{ include('appointments/_delete_form.html.twig') }}
    </div>

{% endblock %}