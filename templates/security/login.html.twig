{% extends 'base_site.html.twig' %}

{% block title %}Log in | Curlétte Hair Studio{% endblock %}

{% block body %}

    <section class="sign-page">
        <div class="sign-shell">

            <aside class="sign-aside">
                <img src="{{ asset('images/salon.jpg') }}" alt="" class="sign-aside-bg">
                <div class="sign-aside-text">
                    <p class="home-label">WELCOME BACK</p>
                    <h2>Healthy curls,<br><em>confident you.</em></h2>
                </div>
            </aside>

            <div class="sign-main">
                <a href="{{ path('app_home') }}" class="sign-brand">
                    <img src="{{ asset('images/logo.png') }}" alt="Curlétte Hair Studio">
                </a>

                <h1>Log in</h1>
                <p class="sign-sub">Book appointments and order products with your account.</p>

                {% if error %}
                    <div class="sign-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="sign-note">
                        You are logged in as {{ app.user.userIdentifier }}.
                        <form method="post" action="{{ path('app_logout') }}" style="display: inline;">
                            <button type="submit" class="sign-link-button">Log out</button>
                        </form>
                    </div>
                {% endif %}

                <form method="post" class="sign-form">
                    <div class="form-group">
                        <label for="username">Email or username</label>
                        <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="_password" autocomplete="current-password" required>
                    </div>

                    <label class="sign-check">
                        <input type="checkbox" name="_remember_me">
                        <span>Remember me</span>
                    </label>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn-main sign-submit">LOG IN</button>
                </form>

                <p class="sign-switch">No account yet? <a href="{{ path('app_register') }}">Create one</a></p>
            </div>

        </div>
    </section>

{% endblock %}
