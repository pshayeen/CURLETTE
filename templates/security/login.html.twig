{% extends 'base.html.twig' %}

{% block title %}Log in | Curlétte Admin{% endblock %}

{% block layout %}

    <section class="auth-page">
        <div class="auth-card">

            <h1>Log in</h1>
            <p class="auth-sub">Enter your username and password.</p>

            {% if error %}
                <div class="auth-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="auth-note">
                    You are logged in as {{ app.user.userIdentifier }}. <a href="{{ logout_path() }}">Log out</a>
                </div>
            {% endif %}

            <form method="post" class="auth-form">
                <label for="inputUsername">Username</label>
                <input type="text" value="{{ last_username }}" name="username" id="inputUsername" autocomplete="username" required autofocus>

                <label for="inputPassword">Password</label>
                <input type="password" name="password" id="inputPassword" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <div class="auth-check">
                    <input type="checkbox" name="_remember_me" id="rememberMe">
                    <label for="rememberMe">Remember me</label>
                </div>

                <button type="submit" class="auth-submit">LOG IN</button>
            </form>

            <p class="auth-switch">No account yet? <a href="{{ path('app_register') }}">Create one</a></p>
        </div>
    </section>

{% endblock %}